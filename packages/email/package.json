{
  "name": "@sethi-backend/email",
  "version": "0.1.0",
  "description": "SMTP email delivery adapter for Sethi Backend.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@sethi-backend/auth": "workspace:*",
    "nodemailer": "^7.0.10"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^7.0.4"
  }
}
