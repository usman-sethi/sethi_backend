# Application environment
NODE_ENV=development

# HTTP server
HOST=127.0.0.1
PORT=3000

# MongoDB connection
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=sethi_backend_dev
# Development placeholder only; replace with a random value before use.
# Production rejects placeholders and requires at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes-long
JWT_ISSUER=sethi-backend
JWT_AUDIENCE=sethi-backend-api
ACCESS_TOKEN_TTL_SECONDS=900
CORS_ORIGINS=http://localhost:5173
RATE_LIMIT_STORE=memory
REDIS_URL=

# Email delivery (leave SMTP fields blank to disable outbound email)
SMTP_HOST=
SMTP_PORT=587
# Production requires STARTTLS when false (implicit TLS when true).
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
APP_BASE_URL=
EMAIL_VERIFICATION_TOKEN_TTL_SECONDS=86400
PASSWORD_RESET_TOKEN_TTL_SECONDS=1800