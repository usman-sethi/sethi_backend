{
  "name": "@sethi-backend/adapter-fastify",
  "version": "0.1.0",
  "description": "Fastify HTTP adapter for Sethi Backend.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@sethi-backend/core": "workspace:*",
    "fastify": "^5.12.8"
  }
}