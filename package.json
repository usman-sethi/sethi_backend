{
  "name": "sethi-backend",
  "version": "0.1.0",
  "private": true,
  "description": "A modular TypeScript backend framework.",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "test": "vitest run",
    "test:integration": "pnpm build && vitest run --config vitest.integration.config.mts",
    "test:services:up": "docker compose -f docker-compose.test.yml up -d --wait mongodb mailpit verdaccio",
    "test:services:wait": "node scripts/wait-for-test-http-services.mjs",
    "test:services:down": "docker compose -f docker-compose.test.yml down --volumes",
    "validate:packages": "node scripts/validate-package-consumer.mjs",
    "test:watch": "vitest",
    "clean": "pnpm --recursive --if-present clean"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
